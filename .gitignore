# Node Dependencies (Must be ignored so GitHub upload succeeds instantly)
node_modules/
client/node_modules/
server/node_modules/

# Build outputs (Render builds these automatically using npm run render-build)
client/dist/
server/dist/

# Environment and sensitive secrets
.env
.env.local
*.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploaded media
server/uploads/
!server/uploads/.gitkeep

# OS metadata
.DS_Store
Thumbs.db

# SQLite database files (Database is initialized automatically on server start)
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm

# Editor directories
.vscode/
.idea/
