# Backend Server Port & Auth
PORT=5000
JWT_SECRET=crimelytixs_secure_jwt_token_secret_2026_rbac

# Database & Storage (MANDATORY FOR PRODUCTION MEDIA PERSISTENCE)
# Persistent buckets: emergency-images, emergency-audio, evidence-files
# SUPABASE_SERVICE_ROLE_KEY is required on the backend to bypass storage RLS and manage buckets
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email Delivery API Configuration
# Required for sending real OTP verification emails to user inbox
RESEND_API_KEY=
RESEND_FROM=Crime Analytics Portal <onboarding@resend.dev>

